---
interface Props {
  color?: string;
  size?: number;
  class?: string;
  style?: string;
}

const {
  color = '#f08322',
  size = 14,
  class: className = '',
  style = '',
} = Astro.props;
---

<div
  class={className}
  style={`width: ${size}px; height: ${size}px; background-color: ${color}; transform: rotate(45deg); border-radius: 2px; ${style}`}
  aria-hidden="true"
></div>

