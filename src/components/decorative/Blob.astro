---
interface Props {
  color?: string;
  width?: string | number;
  height?: string | number;
  opacity?: number;
  class?: string;
  style?: string;
}

const {
  color = '#fdc800',
  width = 200,
  height = 200,
  opacity = 1,
  class: className = '',
  style = '',
} = Astro.props;

const widthVal = typeof width === 'number' ? `${width}px` : width;
const heightVal = typeof height === 'number' ? `${height}px` : height;
---

<div
  class={className}
  style={`background-color: ${color}; width: ${widthVal}; height: ${heightVal}; opacity: ${opacity}; border-radius: 60% 40% 55% 45% / 45% 55% 40% 60%; ${style}`}
  aria-hidden="true"
></div>

