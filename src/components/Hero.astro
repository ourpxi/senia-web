---
import Blob from './decorative/Blob.astro';
import Star from './decorative/Star.astro';
import DiamondDot from './decorative/DiamondDot.astro';
import Squiggle from './decorative/Squiggle.astro';
---

<section
  id="home"
  style="position: relative; overflow: hidden; padding: 70px 24px 90px; background: var(--color-offwhite);"
>
  <!-- Background subtle decorative shapes -->
  <Blob
    color="var(--color-yellow)"
    width={340}
    height={320}
    opacity={0.25}
    style="position: absolute; top: -60px; right: -50px; pointer-events: none;"
  />
  <Blob
    color="var(--color-sky)"
    width={240}
    height={230}
    opacity={0.2}
    style="position: absolute; bottom: 10px; left: -50px; pointer-events: none;"
  />
  <Star
    color="var(--color-coral)"
    size={28}
    style="position: absolute; top: 70px; right: 14%; opacity: 0.6; pointer-events: none;"
  />
  <Star
    color="var(--color-mint)"
    size={20}
    style="position: absolute; bottom: 80px; right: 28%; opacity: 0.5; pointer-events: none;"
  />
  <DiamondDot
    color="var(--color-orange)"
    size={18}
    style="position: absolute; top: 110px; left: 7%; pointer-events: none;"
  />
  <DiamondDot
    color="var(--color-coral)"
    size={12}
    style="position: absolute; bottom: 90px; left: 18%; pointer-events: none;"
  />

  <div
    style="max-width: 1120px; margin: 0 auto; display: grid; grid-template-columns: 1fr; gap: 48px; align-items: center;"
    class="lg:grid-cols-2"
  >
    <!-- Text Column -->
    <div style="position: relative; z-index: 1;">
      <!-- Pill Badge -->
      <div
        style="display: inline-flex; align-items: center; gap: 8px; background: var(--color-yellow); border-radius: 100px; padding: 6px 18px; margin-bottom: 20px; box-shadow: 2px 2px 0px rgba(0,0,0,0.08);"
      >
        <span style="font-size: 16px;"></span>
        <span
          style="font-weight: 800; font-size: 13px; color: #333; letter-spacing: 0.6px; text-transform: uppercase;"
        >
          Estudio de Animación 2D · Inclusión Infantil
        </span>
      </div>

      <!-- Main Headline -->
      <h1
        style="font-family: var(--font-display); font-size: clamp(38px, 6vw, 64px); line-height: 1.1; color: var(--color-dark); margin-bottom: 8px;"
      >
        ¿Quiénes somos?
      </h1>

      <div style="position: relative; display: inline-block; margin-bottom: 24px;">
        <h2
          style="font-family: var(--font-display); font-size: clamp(24px, 4.2vw, 40px); line-height: 1.2; color: var(--color-coral);"
        >
          Somos Senia Animations
        </h2>
        <Squiggle
          color="var(--color-yellow)"
          strokeWidth={4}
          style="position: absolute; bottom: -10px; left: 0;"
        />
      </div>

      <!-- Brand Slogan -->
      <div
        style="display: inline-block; background: rgba(0, 181, 233, 0.12); border-left: 4px solid var(--color-sky); border-radius: 4px 12px 12px 4px; padding: 8px 16px; margin-bottom: 20px;"
      >
        <p style="font-weight: 800; font-size: 16px; color: #087094; font-style: italic;">
          “Señas que nos unen”
        </p>
      </div>

      <!-- Descriptive Pitch -->
      <p
        style="font-size: 17px; line-height: 1.75; color: #444; max-width: 530px; margin-bottom: 34px; font-weight: 500;"
      >
        Un proyecto creativo dedicado a sensibilizar sobre la vida de los <strong style="color: var(--color-coral);">niños y niñas con discapacidad auditiva</strong>. 
        A través de la animación 2D y un rompecabezas educativo interactivo, creamos mundos llenos de color, empatía y comprensión mutua.
      </p>

      <!-- Action Buttons -->
      <div style="display: flex; gap: 14px; flex-wrap: wrap;">
        <a href="#work" class="btn-primary">
          Ver Nuestro Trabajo
        </a>
        <a href="#about" class="btn-secondary">
          Nuestra Misión
        </a>
        <a href="#team" class="btn-secondary" style="border-color: var(--color-sky); color: var(--color-sky);">
          Conoce el Equipo
        </a>
      </div>
    </div>

    <!-- Illustration Column -->
    <div style="display: flex; justify-content: center; align-items: center; position: relative;">
      <div style="position: relative; width: 100%; max-width: 440px; display: flex; justify-content: center;">
        
        <!-- Main Graphic Card with Sign Pattern -->
        <div
          class="float"
          style="width: 320px; height: 320px; background: #ffffff; border-radius: 50% 40% 55% 45% / 40% 55% 45% 60%; border: 4px solid #ffffff; box-shadow: 10px 14px 0px rgba(240, 131, 34, 0.25); display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; overflow: hidden; padding: 24px;"
        >
          <!-- Subtle Pattern Background -->
          <div
            style="position: absolute; inset: 0; background-image: url('/background.png'); background-size: 260px; opacity: 0.16; pointer-events: none;"
          ></div>

          <!-- Logo Inside Circle -->
          <div style="position: relative; z-index: 2; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <img
              src="/senialogo.webp"
              alt="Senia Logo Principal"
              style="width: 220px; height: auto; max-width: 90%; object-fit: contain; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.08));"
            />
            <span
              style="font-family: var(--font-display); font-size: 14px; color: var(--color-mint); margin-top: 10px; background: #e0f5ef; border-radius: 100px; padding: 4px 14px; border: 1.5px solid var(--color-mint);"
            >
              Animación & Rompecabezas
            </span>
          </div>
        </div>

        <!-- Floating Badge 1: Top Right Star -->
        <div
          class="float2"
          style="position: absolute; top: -16px; right: 18px; z-index: 3;"
        >
          <div
            style="background: var(--color-coral); width: 62px; height: 62px; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 4px 4px 0 rgba(0,0,0,0.12); font-size: 28px;"
            title="Creatividad"
          >
            <img
              src="icons/notebook.png"
              alt="Chispa"
              style="width: 36px; height: 36px; object-fit: contain;">
          </div>
        </div>

        <!-- Floating Badge 2: Bottom Left Heart / Star -->
        <div
          class="float"
          style="position: absolute; bottom: 8px; left: 12px; z-index: 3;"
        >
          <div
            style="width: 58px; height: 58px; background: var(--color-sky); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 26px; box-shadow: 4px 4px 0 rgba(0,0,0,0.12);"
            title="Inclusión"
          >
            <img
              src="icons/football.png"
              alt="Chispa"
              style="width: 36px; height: 36px; object-fit: contain;">
          </div>
        </div>

        <!-- Floating Badge 3: Top Left Yellow Sparkle -->
        <div
          class="float2"
          style="position: absolute; top: 35px; left: 0px; z-index: 3;"
        >
          <div
            style="width: 48px; height: 48px; background: var(--color-yellow); border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; display: flex; align-items: center; justify-content: center; font-size: 24px; box-shadow: 3px 3px 0 rgba(0,0,0,0.1);"
            title="Alegría"
          >
            <img
              src="icons/stepsred.png"
              alt="Chispa"
              style="width: 32px; height: 32px; object-fit: contain;">
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
